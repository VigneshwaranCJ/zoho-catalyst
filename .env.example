# =====================================================================
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
# Values here are safe local-development placeholders only.
# =====================================================================

# --- General ---
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production (machine-readable logs)

# --- Security ---
# Generate a strong value:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                 # true in production (HTTPS only)
CORS_ORIGINS=http://localhost:3000  # comma-separated dashboard origins

# --- PostgreSQL ---
# Two roles: the OWNER runs migrations; the APP role is used at runtime
# and is subject to Row-Level Security (it cannot bypass tenant isolation).
POSTGRES_DB=csp
POSTGRES_OWNER_USER=csp_owner
POSTGRES_OWNER_PASSWORD=csp_owner_dev_password
POSTGRES_APP_USER=csp_app
POSTGRES_APP_PASSWORD=csp_app_dev_password
POSTGRES_HOST=127.0.0.1             # "postgres" inside Docker Compose (127.0.0.1, not localhost: avoids slow IPv6 fallback on Windows)
POSTGRES_PORT=5433                  # host port of the Docker Postgres (5432 inside Docker)
POSTGRES_HOST_PORT=5433

# --- Valkey (Redis-compatible) ---
REDIS_URL=redis://127.0.0.1:6379/0  # redis://valkey:6379/0 inside Docker Compose

# --- Email (Mailpit catches all mail in development: http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=support-bot@technova.example

# --- Seed data (local development only) ---
SEED_ADMIN_EMAIL=admin@technova.example
SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only-123

# --- Anthropic Claude (needed from Phase 4) ---
# Create a key at https://console.anthropic.com -> API Keys. Set a monthly spend limit.
ANTHROPIC_API_KEY=
CLAUDE_MAIN_MODEL=claude-sonnet-5-5
CLAUDE_LIGHT_MODEL=claude-haiku-5-5

# --- Langfuse tracing (optional, from Phase 5) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Ticketing (Phase 7) ---
TICKET_PROVIDER=mock                # mock | zoho_desk
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
